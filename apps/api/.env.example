# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=talentshowcase
DB_PASSWORD=talentshowcase
DB_NAME=talentshowcase

# Auth / JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m

# MFA (TOTP)
MFA_ISSUER=TalentShowcase

# Storage: minio | local | auto (auto = MinIO when reachable, else local disk)
STORAGE_DRIVER=auto
STORAGE_LOCAL_DIR=.storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=talentshowcase

# Async queue: leave empty for in-process fallback; set to use RabbitMQ
# RABBITMQ_URL=amqp://talentshowcase:talentshowcase@localhost:5672

# LLM (OpenAI-compatible: GLM / DeepSeek)
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_FALLBACK_MODEL=local-fallback
